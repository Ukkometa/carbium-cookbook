# Carbium credentials. Copy to .env and fill in. .env is gitignored.
#
# These are TWO DIFFERENT keys, issued separately in the dashboard.
#
#   RPC   https://rpc-service.carbium.io/?apiKey=<CARBIUM_RPC_KEY>
#   Swap  https://api.carbium.io/api/v2   header: X-API-KEY: <CARBIUM_API_KEY>
#
# The RPC key travels in the URL query string, which makes the whole
# connection URL a secret. Build it from the key at runtime and never log it.

CARBIUM_RPC_KEY=
CARBIUM_API_KEY=
